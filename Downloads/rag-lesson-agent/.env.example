# anthropic | openai | ollama | mock   (mock = offline, scripted, for tests/CI only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Generator and judge are separate models on purpose (reduces self-preference bias)
GEN_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5
MAX_RETRIES=2
MEMORY_PATH=memory/memory.json
